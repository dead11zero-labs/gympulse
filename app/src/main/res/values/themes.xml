<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fenster-Theme bis Compose übernimmt; das eigentliche Theme ist GymPulseTheme.
         AppCompat-Basis, weil MainActivity eine AppCompatActivity ist (Per-App-Sprache). -->
    <style name="Theme.GymPulse" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Splash über androidx.core:splashscreen; danach gilt Theme.GymPulse. -->
    <style name="Theme.GymPulse.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.GymPulse</item>
    </style>
</resources>
